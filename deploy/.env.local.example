# For docker-compose.local.yml (same-host deploy, no SSH) only — copy to
# deploy/.env.local or set directly as Portainer stack environment
# variables. Do not commit real values. See deploy/README.md's "Same-host
# deploy (no SSH)" section.
RCON_PASSWORD=
AMP_HOST=
# Host path to the Palworld server's SaveGames/<world_guid> dir (containing
# Level.sav + Players/*.sav) — bind-mounted read-only into the container.
PALWORLD_SAVE_HOST_PATH=
